{
  "name": "@liquidx/liquidx-japan-train-lines",
  "version": "5.1.20260522",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "vitest run",
    "release": "./publish.sh",
    "data": "bash tools/get-data.sh",
    "build:prefectures": "node tools/build-prefecture-polygons.js",
    "build:index": "node tools/build-line-region-index.js",
    "build:static": "pnpm run build:prefectures && pnpm run build:index"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "svelte": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.16.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/package": "^2.5.7",
    "@tailwindcss/vite": "^4.3.0",
    "@vercel/analytics": "^2.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "publint": "^0.3.21",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.0"
  },
  "type": "module",
  "dependencies": {
    "lodash-es": "^4.17.21",
    "open-data-jp-prefectures-geojson": "^1.1.0",
    "svgson": "^5.3.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}